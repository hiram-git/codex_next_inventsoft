---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { store } from '../../../lib/store';

let mensaje = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  store.updateEmpresa({
    nombre: formData.get('nombre')?.toString() ?? '',
    rfc: formData.get('rfc')?.toString() ?? '',
    direccion: formData.get('direccion')?.toString() ?? '',
    telefono: formData.get('telefono')?.toString() ?? '',
    email: formData.get('email')?.toString() ?? '',
  });
  mensaje = 'Datos de la empresa actualizados.';
}

const empresa = store.getEmpresa();
---

<AdminLayout title="Datos de Empresa">
  <div class="page-header">
    <h1>Datos de la Empresa</h1>
  </div>

  {mensaje && <div class="alert alert-success">{mensaje}</div>}

  <div class="card" style="max-width:600px">
    <form method="POST">
      <div class="form-group">
        <label>Nombre de la Empresa</label>
        <input type="text" name="nombre" class="form-control" value={empresa.nombre} required />
      </div>
      <div class="form-group">
        <label>RFC</label>
        <input type="text" name="rfc" class="form-control" value={empresa.rfc} required />
      </div>
      <div class="form-group">
        <label>Dirección</label>
        <textarea name="direccion" class="form-control" rows="2">{empresa.direccion}</textarea>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div class="form-group">
          <label>Teléfono</label>
          <input type="text" name="telefono" class="form-control" value={empresa.telefono} />
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" class="form-control" value={empresa.email} />
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;margin-top:8px">
        <button type="submit" class="btn btn-primary">
          <span class="material-icons-round" style="font-size:18px">save</span> Guardar Cambios
        </button>
      </div>
    </form>
  </div>
</AdminLayout>
