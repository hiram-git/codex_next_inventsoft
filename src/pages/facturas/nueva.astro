---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { store } from '../../lib/store';

let error = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const clienteId = formData.get('clienteId')?.toString() ?? '';
  const almacenId = formData.get('almacenId')?.toString() ?? '';
  const cliente = await store.getCliente(clienteId);

  if (!cliente) {
    error = 'Seleccione un cliente válido.';
  } else {
    const itemsJson = formData.get('items_json')?.toString() ?? '[]';
    let items;
    try { items = JSON.parse(itemsJson); } catch { items = []; }

    if (items.length === 0) {
      error = 'Agregue al menos un producto o servicio a la factura.';
    } else {
      const subtotal = items.reduce((sum: number, item: { subtotal: number }) => sum + item.subtotal, 0);
      const iva = subtotal * 0.16;
      const total = subtotal + iva;

      let almacenNombre = '';
      if (almacenId) {
        const almacen = await store.getAlmacen(almacenId);
        almacenNombre = almacen?.nombre ?? '';
      }

      await store.createFactura({
        clienteId,
        clienteNombre: cliente.nombre,
        almacenId: almacenId || undefined,
        almacenNombre: almacenNombre || undefined,
        items,
        subtotal,
        iva,
        total,
        estado: 'pendiente',
        fecha: new Date().toISOString().split('T')[0],
      });

      return Astro.redirect('/facturas');
    }
  }
}

const [clientes, almacenes, allProductos, allServicios] = await Promise.all([
  store.getClientes(),
  store.getAlmacenes(),
  store.getProductos(),
  store.getServicios(),
]);
const productos = allProductos.filter(p => p.activo);
const servicios = allServicios.filter(s => s.activo);
---

<AdminLayout title="Nueva Factura">
  <div class="page-header">
    <h1>Nueva Factura</h1>
    <a href="/facturas" class="btn btn-secondary">
      <span class="material-icons-round">arrow_back</span> Volver
    </a>
  </div>

  {error && <div class="alert alert-error">{error}</div>}

  <form method="POST" id="facturaForm">
    <input type="hidden" name="items_json" id="itemsJson" value="[]" />

    <div class="card" style="margin-bottom:16px">
      <h2 style="font-size:1.1rem;margin-bottom:16px">Datos de la Factura</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px">
        <div class="form-group">
          <label>Cliente</label>
          <select name="clienteId" class="form-control" required>
            <option value="">Seleccionar cliente...</option>
            {clientes.map(c => (
              <option value={c.id}>{c.nombre} - {c.rfc}</option>
            ))}
          </select>
        </div>
        <div class="form-group">
          <label>Almacén (salida de inventario de productos)</label>
          <select name="almacenId" class="form-control">
            <option value="">Sin afectar inventario</option>
            {almacenes.filter(a => a.activo).map(a => (
              <option value={a.id}>{a.nombre}</option>
            ))}
          </select>
        </div>
        <div class="form-group">
          <label>Fecha</label>
          <input type="date" class="form-control" value={new Date().toISOString().split('T')[0]} disabled />
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom:16px">
      <h2 style="font-size:1.1rem;margin-bottom:16px">Productos y Servicios</h2>

      <div style="display:grid;grid-template-columns:2fr 1fr auto;gap:8px;margin-bottom:16px;align-items:end">
        <div class="form-group" style="margin-bottom:0">
          <label>Producto / Servicio</label>
          <select id="selItem" class="form-control">
            <option value="">Seleccionar...</option>
            {productos.length > 0 && (
              <optgroup label="📦 Productos (afectan inventario)">
                {productos.map(p => (
                  <option
                    value={`producto:${p.id}`}
                    data-tipo="producto"
                    data-nombre={p.nombre}
                    data-precio={p.precio}
                    data-stock={p.stock}
                  >
                    {p.nombre} — ${p.precio.toLocaleString('es-MX', { minimumFractionDigits: 2 })} (Stock: {p.stock})
                  </option>
                ))}
              </optgroup>
            )}
            {servicios.length > 0 && (
              <optgroup label="🔧 Servicios (no afectan inventario)">
                {servicios.map(s => (
                  <option
                    value={`servicio:${s.id}`}
                    data-tipo="servicio"
                    data-nombre={s.nombre}
                    data-precio={s.precio}
                    data-stock="999999"
                  >
                    {s.nombre} — ${s.precio.toLocaleString('es-MX', { minimumFractionDigits: 2 })}
                  </option>
                ))}
              </optgroup>
            )}
          </select>
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label>Cantidad</label>
          <input type="number" id="cantidad" class="form-control" min="1" value="1" />
        </div>
        <button type="button" class="btn btn-success" onclick="addItem()" style="height:38px">
          <span class="material-icons-round" style="font-size:18px">add</span> Agregar
        </button>
      </div>

      <table>
        <thead>
          <tr>
            <th>Descripción</th>
            <th>Tipo</th>
            <th>P. Unitario</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="itemsBody">
          <tr>
            <td colspan="6" style="text-align:center;color:var(--text-muted)">No se han agregado items.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="card">
      <div class="totals">
        <div class="total-row">
          <span>Subtotal:</span>
          <span id="subtotalDisplay">$0.00</span>
        </div>
        <div class="total-row">
          <span>IVA (16%):</span>
          <span id="ivaDisplay">$0.00</span>
        </div>
        <div class="total-row total-final">
          <span>Total:</span>
          <span id="totalDisplay">$0.00</span>
        </div>
      </div>

      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px">
        <a href="/facturas" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">
          <span class="material-icons-round" style="font-size:18px">save</span> Crear Factura
        </button>
      </div>
    </div>
  </form>
</AdminLayout>

<style>
  .totals { max-width: 300px; margin-left: auto; }
  .total-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 0.95rem; }
  .total-row + .total-row { border-top: 1px solid var(--border); }
  .total-final { font-size: 1.15rem; font-weight: 700; color: var(--primary); }
</style>

<script is:inline>
  let items = [];

  function addItem() {
    const sel = document.getElementById('selItem');
    const cantInput = document.getElementById('cantidad');
    const opt = sel.options[sel.selectedIndex];

    if (!sel.value) return alert('Seleccione un producto o servicio.');

    const [tipo, itemId] = sel.value.split(':');
    const productoNombre = opt.dataset.nombre;
    const precioUnitario = parseFloat(opt.dataset.precio);
    const stock = parseInt(opt.dataset.stock);
    const cantidad = parseInt(cantInput.value) || 1;

    if (cantidad <= 0) return alert('La cantidad debe ser mayor a 0.');
    if (tipo === 'producto' && cantidad > stock) {
      return alert(`Stock insuficiente. Disponible: ${stock}`);
    }

    const existing = items.find(i => i.tipo === tipo && i.productoId === itemId);
    if (existing) {
      existing.cantidad += cantidad;
      existing.subtotal = existing.cantidad * existing.precioUnitario;
    } else {
      items.push({ tipo, productoId: itemId, productoNombre, cantidad, precioUnitario, subtotal: cantidad * precioUnitario });
    }

    sel.value = '';
    cantInput.value = '1';
    renderItems();
  }

  function removeItem(index) {
    items.splice(index, 1);
    renderItems();
  }

  function renderItems() {
    const tbody = document.getElementById('itemsBody');
    const fmt = (n) => '$' + n.toLocaleString('es-MX', { minimumFractionDigits: 2 });

    if (items.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text-muted)">No se han agregado items.</td></tr>';
    } else {
      tbody.innerHTML = items.map((item, i) => `
        <tr>
          <td>${item.productoNombre}</td>
          <td>
            ${item.tipo === 'servicio'
              ? '<span style="background:var(--bg);color:var(--text-muted);padding:2px 8px;border-radius:12px;font-size:0.75rem;font-weight:600">Servicio</span>'
              : '<span style="background:#dcfce7;color:#16a34a;padding:2px 8px;border-radius:12px;font-size:0.75rem;font-weight:600">Producto</span>'
            }
          </td>
          <td>${fmt(item.precioUnitario)}</td>
          <td>${item.cantidad}</td>
          <td><strong>${fmt(item.subtotal)}</strong></td>
          <td>
            <button type="button" class="btn btn-danger btn-sm" onclick="removeItem(${i})">
              <span class="material-icons-round" style="font-size:16px">close</span>
            </button>
          </td>
        </tr>
      `).join('');
    }

    const subtotal = items.reduce((s, i) => s + i.subtotal, 0);
    const iva = subtotal * 0.16;
    const total = subtotal + iva;

    document.getElementById('subtotalDisplay').textContent = fmt(subtotal);
    document.getElementById('ivaDisplay').textContent = fmt(iva);
    document.getElementById('totalDisplay').textContent = fmt(total);
    document.getElementById('itemsJson').value = JSON.stringify(items);
  }
</script>
