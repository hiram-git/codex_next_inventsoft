---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { store } from '../../lib/store';

let error = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const clienteId = formData.get('clienteId')?.toString() ?? '';
  const almacenId = formData.get('almacenId')?.toString() ?? '';
  const notas = formData.get('notas')?.toString() ?? '';

  const [cliente, almacen] = await Promise.all([
    store.getCliente(clienteId),
    store.getAlmacen(almacenId),
  ]);

  if (!cliente) {
    error = 'Seleccione un cliente válido.';
  } else if (!almacen) {
    error = 'Seleccione un almacén válido.';
  } else {
    const itemsJson = formData.get('items_json')?.toString() ?? '[]';
    let items;
    try { items = JSON.parse(itemsJson); } catch { items = []; }

    if (items.length === 0) {
      error = 'Agregue al menos un producto al pedido.';
    } else {
      const subtotal = items.reduce((sum: number, i: { subtotal: number }) => sum + i.subtotal, 0);
      const iva = subtotal * 0.16;
      const total = subtotal + iva;

      await store.createPedido({
        clienteId,
        clienteNombre: cliente.nombre,
        almacenId,
        almacenNombre: almacen.nombre,
        items,
        subtotal,
        iva,
        total,
        notas,
        fecha: new Date().toISOString().split('T')[0],
      });

      return Astro.redirect('/pedidos');
    }
  }
}

const [clientes, almacenes, allProductos] = await Promise.all([
  store.getClientes(),
  store.getAlmacenes(),
  store.getProductos(),
]);
const productos = allProductos.filter(p => p.activo);
---

<AdminLayout title="Nuevo Pedido">
  <div class="page-header">
    <h1>Nuevo Pedido</h1>
    <a href="/pedidos" class="btn btn-secondary">
      <span class="material-icons-round">arrow_back</span> Volver
    </a>
  </div>

  {error && <div class="alert alert-error">{error}</div>}

  <form method="POST" id="pedidoForm">
    <input type="hidden" name="items_json" id="itemsJson" value="[]" />

    <div class="card" style="margin-bottom:16px">
      <h2 style="font-size:1.1rem;margin-bottom:16px">Datos del Pedido</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <div class="form-group">
          <label>Cliente</label>
          <select name="clienteId" class="form-control" required>
            <option value="">Seleccionar cliente...</option>
            {clientes.map(c => (
              <option value={c.id}>{c.nombre}</option>
            ))}
          </select>
        </div>
        <div class="form-group">
          <label>Almacén de origen</label>
          <select name="almacenId" class="form-control" required id="almacenSelect">
            <option value="">Seleccionar almacén...</option>
            {almacenes.filter(a => a.activo).map(a => (
              <option value={a.id}>{a.nombre}</option>
            ))}
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Notas</label>
        <textarea name="notas" class="form-control" rows="2" placeholder="Notas adicionales..."></textarea>
      </div>
    </div>

    <div class="card" style="margin-bottom:16px">
      <h2 style="font-size:1.1rem;margin-bottom:16px">Productos</h2>

      <div style="display:grid;grid-template-columns:2fr 1fr auto;gap:8px;margin-bottom:16px;align-items:end">
        <div class="form-group" style="margin-bottom:0">
          <label>Producto</label>
          <select id="selProducto" class="form-control">
            <option value="">Seleccionar...</option>
            {productos.map(p => (
              <option value={p.id} data-nombre={p.nombre} data-precio={p.precio}>
                {p.nombre} — ${p.precio.toLocaleString('es-MX', { minimumFractionDigits: 2 })}
              </option>
            ))}
          </select>
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label>Cantidad</label>
          <input type="number" id="cantidad" class="form-control" min="1" value="1" />
        </div>
        <button type="button" class="btn btn-success" onclick="addItem()" style="height:38px">
          <span class="material-icons-round" style="font-size:18px">add</span> Agregar
        </button>
      </div>

      <div class="alert alert-info" style="background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;margin-bottom:16px;font-size:0.875rem">
        <span class="material-icons-round" style="font-size:16px;vertical-align:middle">info</span>
        Al confirmar el pedido, el stock se reservará en el almacén seleccionado.
      </div>

      <table>
        <thead>
          <tr>
            <th>Producto</th>
            <th>P. Unitario</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="itemsBody">
          <tr>
            <td colspan="5" style="text-align:center;color:var(--text-muted)">No se han agregado productos.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="card">
      <div class="totals">
        <div class="total-row">
          <span>Subtotal:</span>
          <span id="subtotalDisplay">$0.00</span>
        </div>
        <div class="total-row">
          <span>IVA (16%):</span>
          <span id="ivaDisplay">$0.00</span>
        </div>
        <div class="total-row total-final">
          <span>Total:</span>
          <span id="totalDisplay">$0.00</span>
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px">
        <a href="/pedidos" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">
          <span class="material-icons-round" style="font-size:18px">save</span> Crear Pedido
        </button>
      </div>
    </div>
  </form>
</AdminLayout>

<style>
  .totals { max-width: 300px; margin-left: auto; }
  .total-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 0.95rem; }
  .total-row + .total-row { border-top: 1px solid var(--border); }
  .total-final { font-size: 1.15rem; font-weight: 700; color: var(--primary); }
</style>

<script is:inline>
  let items = [];

  function addItem() {
    const sel = document.getElementById('selProducto');
    const cantInput = document.getElementById('cantidad');
    const opt = sel.options[sel.selectedIndex];

    if (!sel.value) return alert('Seleccione un producto.');
    const productoId = sel.value;
    const productoNombre = opt.dataset.nombre;
    const precioUnitario = parseFloat(opt.dataset.precio);
    const cantidad = parseInt(cantInput.value) || 1;

    if (cantidad <= 0) return alert('La cantidad debe ser mayor a 0.');

    const existing = items.find(i => i.productoId === productoId);
    if (existing) {
      existing.cantidad += cantidad;
      existing.subtotal = existing.cantidad * existing.precioUnitario;
    } else {
      items.push({ productoId, productoNombre, cantidad, precioUnitario, subtotal: cantidad * precioUnitario });
    }

    sel.value = '';
    cantInput.value = '1';
    renderItems();
  }

  function removeItem(index) {
    items.splice(index, 1);
    renderItems();
  }

  function renderItems() {
    const tbody = document.getElementById('itemsBody');
    const fmt = (n) => '$' + n.toLocaleString('es-MX', { minimumFractionDigits: 2 });

    if (items.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--text-muted)">No se han agregado productos.</td></tr>';
    } else {
      tbody.innerHTML = items.map((item, i) => `
        <tr>
          <td>${item.productoNombre}</td>
          <td>${fmt(item.precioUnitario)}</td>
          <td>${item.cantidad}</td>
          <td><strong>${fmt(item.subtotal)}</strong></td>
          <td>
            <button type="button" class="btn btn-danger btn-sm" onclick="removeItem(${i})">
              <span class="material-icons-round" style="font-size:16px">close</span>
            </button>
          </td>
        </tr>
      `).join('');
    }

    const subtotal = items.reduce((s, i) => s + i.subtotal, 0);
    const iva = subtotal * 0.16;
    const total = subtotal + iva;

    document.getElementById('subtotalDisplay').textContent = fmt(subtotal);
    document.getElementById('ivaDisplay').textContent = fmt(iva);
    document.getElementById('totalDisplay').textContent = fmt(total);
    document.getElementById('itemsJson').value = JSON.stringify(items);
  }
</script>
